    "attempt": {
      "type": "object",
      "required": [
        "attempt_id",
        "created_at",
        "plan_digest",
        "resources",
        "scheduler",
        "state",
        "submission"
      ],
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "plan_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "state": {
          "enum": [
            "registered",
            "prepared",
            "submitted",
            "submission_uncertain"
          ]
        },
        "created_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "submission": {
          "type": "object",
          "required": [
            "job_id",
            "requested",
            "submitted_at_local"
          ],
          "additionalProperties": false,
          "properties": {
            "requested": {
              "type": "boolean"
            },
            "job_id": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9]{1,20}(_[0-9]{1,10})?$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "submitted_at_local": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "scheduler": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "available",
                "checked_at",
                "elapsed",
                "ended_at",
                "exit_code",
                "started_at",
                "state",
                "summary",
                "terminal"
              ],
              "additionalProperties": false,
              "properties": {
                "available": {
                  "type": "boolean"
                },
                "summary": {
                  "enum": [
                    "PENDING",
                    "RUNNING",
                    "SUCCESS",
                    "FAILURE",
                    "UNKNOWN"
                  ]
                },
                "state": {
                  "enum": [
                    "PENDING",
                    "CONFIGURING",
                    "RUNNING",
                    "COMPLETING",
                    "COMPLETED",
                    "FAILED",
                    "TIMEOUT",
                    "CANCELLED",
                    "OUT_OF_MEMORY",
                    "NODE_FAIL",
                    "PREEMPTED",
                    "BOOT_FAIL",
                    "DEADLINE",
                    "SUSPENDED",
                    "REQUEUED",
                    "REQUEUE_HOLD",
                    "REQUEUE_FED",
                    "RESIZING",
                    "SIGNALING",
                    "STAGE_OUT",
                    "SPECIAL_EXIT",
                    "STOPPED",
                    "REVOKED",
                    "RESV_DEL_HOLD",
                    "UNKNOWN"
                  ]
                },
                "exit_code": {
                  "oneOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9]{1,3}:[0-9]{1,3}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "elapsed": {
                  "oneOf": [
                    {
                      "type": "string",
                      "pattern": "^([0-9]{1,4}-)?[0-9]{2}:[0-9]{2}:[0-9]{2}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "started_at": {
                  "oneOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "ended_at": {
                  "oneOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "terminal": {
                  "type": "boolean"
                },
                "checked_at": {
                  "oneOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "local": {
      "type": "object",
      "required": [
        "expected_plan_digest",
