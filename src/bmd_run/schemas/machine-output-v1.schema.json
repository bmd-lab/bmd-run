{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bmd_run.machine_output/1",
  "title": "BMD Run machine-API output document, schema version 1",
  "description": "Emitted on stdout by every 'bmd-run api' command run with --json, on success and on error. Every object is closed. Every string in 'result' and 'error' is a client constant, the client's own copy of a member of its closed BMD Compute machine-API v1 vocabulary (pinned to bmd-compute e3fbb3b), a value from the user's own request, a digest, job ID or timestamp re-rendered by the client after strict pattern checks, or a bounded number. No Compute prose is relayed and the API token never appears.",
  "type": "object",
  "required": [
    "client",
    "command",
    "compute_api",
    "error",
    "ok",
    "request",
    "result",
    "schema",
    "schema_version",
    "warnings"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "bmd_run.machine_output"
    },
    "schema_version": {
      "const": 1
    },
    "client": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "bmd-run"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "command": {
      "oneOf": [
        {
          "enum": [
            "plan",
            "prepare",
            "submit",
            "status"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "ok": {
      "type": "boolean"
    },
    "compute_api": {
      "type": "object",
      "required": [
        "api_version",
        "origin",
        "reference_commit"
      ],
      "additionalProperties": false,
      "properties": {
        "origin": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "api_version": {
          "const": "v1"
        },
        "reference_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "request": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "attempt_id"
          ],
          "additionalProperties": false,
          "properties": {
            "attempt_id": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "custom_stage_count",
            "desired_output",
            "resources",
            "structure_format",
            "structure_source",
            "workflow_mode"
          ],
          "additionalProperties": false,
          "properties": {
            "structure_format": {
              "enum": [
                "poscar",
                "cif"
              ]
            },
            "workflow_mode": {
              "enum": [
                "desired_output",
                "custom"
              ]
            },
            "desired_output": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9_]{0,63}$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "custom_stage_count": {
              "oneOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "resources": {
              "type": "object",
              "required": [],
              "additionalProperties": false,
              "properties": {
                "cpus": {
                  "type": "integer"
                },
                "memory_gb": {
                  "type": "integer"
                },
                "walltime": {
                  "type": "string",
                  "pattern": "^[0-9]{2,3}:[0-5][0-9]:[0-5][0-9]$"
                },
                "queue": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
                }
              }
            },
            "structure_source": {
              "$ref": "#/$defs/structure_source"
            }
          }
        }
      ]
    },
    "result": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/plan"
        },
        {
          "$ref": "#/$defs/prepare_result"
        },
        {
          "$ref": "#/$defs/attempt_result"
        }
      ]
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/error"
        }
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "request_summary": {
      "type": "object",
      "required": [
        "custom_stage_count",
        "desired_output",
        "resources",
        "structure_format",
        "workflow_mode"
      ],
      "additionalProperties": false,
      "properties": {
        "structure_format": {
          "enum": [
            "poscar",
            "cif"
          ]
        },
        "workflow_mode": {
          "enum": [
            "desired_output",
            "custom"
          ]
        },
        "desired_output": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_]{0,63}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "custom_stage_count": {
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "resources": {
          "type": "object",
          "required": [],
          "additionalProperties": false,
          "properties": {
            "cpus": {
              "type": "integer"
            },
            "memory_gb": {
              "type": "integer"
            },
            "walltime": {
              "type": "string",
              "pattern": "^[0-9]{2,3}:[0-5][0-9]:[0-5][0-9]$"
            },
            "queue": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
            }
          }
        }
      }
    },
    "structure_source": {
      "type": "object",
      "required": [
        "file_name",
        "format",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "file_name": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "format": {
          "enum": [
            "poscar",
            "cif"
          ]
        }
      }
    },
    "resources": {
      "type": "object",
      "required": [
        "account",
        "cpus",
        "memory_gb",
        "nodes",
        "partition",
        "walltime"
      ],
      "additionalProperties": false,
      "properties": {
        "nodes": {
          "type": "integer"
        },
        "cpus": {
          "type": "integer"
        },
        "memory_gb": {
          "type": "integer"
        },
        "walltime": {
          "type": "string",
          "pattern": "^[0-9]{2,3}:[0-5][0-9]:[0-5][0-9]$"
        },
        "partition": {
          "oneOf": [
            {
              "enum": [
                "leeburton-pool"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "account": {
          "oneOf": [
            {
              "enum": [
                "power-leeburton-users_v2"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "stage": {
      "type": "object",
      "required": [
        "dft_u",
        "index",
        "modifiers",
        "option_count",
        "stage_type",
        "theory",
        "unrecognized_modifier_count",
        "vasp_executable"
      ],
      "additionalProperties": false,
      "properties": {
        "index": {
          "type": "integer"
        },
        "stage_type": {
          "oneOf": [
            {
              "enum": [
                "relax",
                "static",
                "dos",
                "band_structure",
                "phonon_forces"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "theory": {
          "oneOf": [
            {
              "enum": [
                "pbe",
                "r2scan",
                "hse06"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "modifiers": {
          "type": "array",
          "items": {
            "enum": [
              "soc",
              "dft_u",
              "dispersion",
              "spin_polarized",
              "gamma_only",
              "ions_only"
            ]
          }
        },
        "unrecognized_modifier_count": {
          "type": "integer"
        },
        "vasp_executable": {
          "oneOf": [
            {
              "enum": [
                "vasp_std",
                "vasp_ncl",
                "vasp_gam"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "option_count": {
          "type": "integer"
        },
        "dft_u": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "ldautype",
                "species"
              ],
              "additionalProperties": false,
              "properties": {
                "ldautype": {
                  "oneOf": [
                    {
                      "type": "integer"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "species": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "object",
                    "required": [
                      "J",
                      "L",
                      "U"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "U": {
                        "type": "number"
                      },
                      "J": {
                        "type": "number"
                      },
                      "L": {
                        "type": "number"
                      }
                    }
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "consideration": {
      "type": "object",
      "required": [
        "automatic_application_state",
        "automatic_stage_indices",
        "id",
        "method",
        "modifier",
        "selection_state",
        "status",
        "trigger_elements"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "enum": [
            "spin.composition_screen",
            "dftu.mp_oxide_fluoride",
            "soc.heavy_elements",
            "dispersion.two_dimensional_connectivity"
          ]
        },
        "method": {
          "oneOf": [
            {
              "enum": [
                "dft_u",
                "soc",
                "spin_polarisation",
                "dispersion"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "modifier": {
          "oneOf": [
            {
              "enum": [
                "soc",
                "dft_u",
                "dispersion",
                "spin_polarized",
                "gamma_only",
                "ions_only"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "oneOf": [
            {
              "enum": [
                "recommended_for_consideration",
                "suppressed_by_d0_gate"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "selection_state": {
          "oneOf": [
            {
              "enum": [
                "not_selected",
                "already_selected"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "automatic_application_state": {
          "oneOf": [
            {
              "enum": [
                "applied",
                "omitted_unsupported_combination",
                "not_applicable",
                "advisory"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "trigger_elements": {
          "type": "array",
          "items": {
            "enum": [
              "H",
              "He",
              "Li",
              "Be",
              "B",
              "C",
              "N",
              "O",
              "F",
              "Ne",
              "Na",
              "Mg",
              "Al",
              "Si",
              "P",
              "S",
              "Cl",
              "Ar",
              "K",
              "Ca",
              "Sc",
              "Ti",
              "V",
              "Cr",
              "Mn",
              "Fe",
              "Co",
              "Ni",
              "Cu",
              "Zn",
              "Ga",
              "Ge",
              "As",
              "Se",
              "Br",
              "Kr",
              "Rb",
              "Sr",
              "Y",
              "Zr",
              "Nb",
              "Mo",
              "Tc",
              "Ru",
              "Rh",
              "Pd",
              "Ag",
              "Cd",
              "In",
              "Sn",
              "Sb",
              "Te",
              "I",
              "Xe",
              "Cs",
              "Ba",
              "La",
              "Ce",
              "Pr",
              "Nd",
              "Pm",
              "Sm",
              "Eu",
              "Gd",
              "Tb",
              "Dy",
              "Ho",
              "Er",
              "Tm",
              "Yb",
              "Lu",
              "Hf",
              "Ta",
              "W",
              "Re",
              "Os",
              "Ir",
              "Pt",
              "Au",
              "Hg",
              "Tl",
              "Pb",
              "Bi",
              "Po",
              "At",
              "Rn",
              "Fr",
              "Ra",
              "Ac",
              "Th",
              "Pa",
              "U",
              "Np",
              "Pu",
              "Am",
              "Cm",
              "Bk",
              "Cf",
              "Es",
              "Fm",
              "Md",
              "No",
              "Lr",
              "Rf",
              "Db",
              "Sg",
              "Bh",
              "Hs",
              "Mt",
              "Ds",
              "Rg",
              "Cn",
              "Nh",
              "Fl",
              "Mc",
              "Lv",
              "Ts",
              "Og"
            ]
          }
        },
        "automatic_stage_indices": {
          "type": "array",
          "items": {
            "type": "integer"
          }
        }
      }
    },
    "incar_tag": {
      "type": "object",
      "required": [
        "tag",
        "value"
      ],
      "additionalProperties": false,
      "properties": {
        "tag": {
          "type": "string"
        },
        "value": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "oneOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "number"
                  }
                ]
              }
            }
          ]
        }
      }
    },
    "input_stage": {
      "type": "object",
      "required": [
        "incar",
        "index",
        "kpoints",
        "poscar",
        "potcar_symbols",
        "unrecognized_potcar_symbol_count"
      ],
      "additionalProperties": false,
      "properties": {
        "index": {
          "type": "integer"
        },
        "incar": {
          "type": "object",
          "required": [
            "sha256",
            "tags",
            "withheld_tag_count"
          ],
          "additionalProperties": false,
          "properties": {
            "tags": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/incar_tag"
              }
            },
            "withheld_tag_count": {
              "type": "integer"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "kpoints": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "mesh",
                "num_kpts",
                "sha256",
                "shift",
                "style"
              ],
              "additionalProperties": false,
              "properties": {
                "style": {
                  "oneOf": [
                    {
                      "enum": [
                        "Gamma",
                        "Monkhorst",
                        "Automatic",
                        "Line_mode",
                        "Cartesian",
                        "Reciprocal"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "num_kpts": {
                  "type": "integer"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "mesh": {
                  "oneOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "integer"
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "shift": {
                  "oneOf": [
                    {
                      "type": "array",
                      "items": {
                        "type": "number"
                      }
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "potcar_symbols": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Z][a-z]?(_[A-Za-z0-9_]{1,8})?$"
          }
        },
        "unrecognized_potcar_symbol_count": {
          "type": "integer"
        },
        "poscar": {
          "type": "object",
          "required": [
            "num_sites",
            "sha256"
          ],
          "additionalProperties": false,
          "properties": {
            "num_sites": {
              "type": "integer"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "plan": {
      "type": "object",
      "required": [
        "capability_schema_version",
        "method_considerations",
        "plan_digest",
        "plan_digest_version",
        "policies",
        "request",
        "resources",
        "scientific_inputs",
        "software",
        "structure",
        "unavailable_from_compute_api",
        "workflow"
      ],
      "additionalProperties": false,
      "properties": {
        "plan_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "plan_digest_version": {
          "enum": [
            1
          ]
        },
        "request": {
          "$ref": "#/$defs/request_summary"
        },
        "structure": {
          "type": "object",
          "required": [
            "canonical_sha256",
            "crystal_system",
            "formula",
            "natoms",
            "reduced_formula",
            "space_group_number",
            "volume_angstrom3"
          ],
          "additionalProperties": false,
          "properties": {
            "formula": {
              "type": "string"
            },
            "reduced_formula": {
              "type": "string"
            },
            "natoms": {
              "type": "integer"
            },
            "space_group_number": {
              "oneOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "crystal_system": {
              "oneOf": [
                {
                  "enum": [
                    "triclinic",
                    "monoclinic",
                    "orthorhombic",
                    "tetragonal",
                    "trigonal",
                    "hexagonal",
                    "cubic"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "volume_angstrom3": {
              "type": "number"
            },
            "canonical_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "workflow": {
          "type": "object",
          "required": [
            "desired_output",
            "stage_count",
            "stages"
          ],
          "additionalProperties": false,
          "properties": {
            "desired_output": {
              "oneOf": [
                {
                  "enum": [
                    "energy_only",
                    "relaxed_structure",
                    "electronic_dos",
                    "electronic_band_structure"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "stage_count": {
              "type": "integer"
            },
            "stages": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/stage"
              }
            }
          }
        },
        "method_considerations": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "considerations",
                "policy_version",
                "unrecognized_count"
              ],
              "additionalProperties": false,
              "properties": {
                "policy_version": {
                  "oneOf": [
                    {
                      "type": "integer"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "considerations": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/consideration"
                  }
                },
                "unrecognized_count": {
                  "type": "integer"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "scientific_inputs": {
          "type": "object",
          "required": [
            "potcar_functional",
            "stages"
          ],
          "additionalProperties": false,
          "properties": {
            "potcar_functional": {
              "oneOf": [
                {
                  "enum": [
                    "PBE",
                    "PBE_52",
                    "PBE_54",
                    "PBE_64",
                    "LDA",
                    "LDA_52",
                    "LDA_54",
                    "LDA_64",
                    "PW91"
                  ]
                },
                {
                  "type": "null"
                }
              ]
            },
            "stages": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/input_stage"
              }
            }
          }
        },
        "software": {
          "type": "object",
          "required": [
            "module_count",
            "runtime_parity_packages"
          ],
          "additionalProperties": false,
          "properties": {
            "module_count": {
              "type": "integer"
            },
            "runtime_parity_packages": {
              "type": "object",
              "required": [
                "atomate2",
                "custodian",
                "emmet-core",
                "jobflow",
                "pymatgen",
                "pymatgen-core",
                "spglib"
              ],
              "additionalProperties": false,
              "properties": {
                "atomate2": {
                  "oneOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9]+(\\.[0-9]+){0,3}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "pymatgen": {
                  "oneOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9]+(\\.[0-9]+){0,3}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "pymatgen-core": {
                  "oneOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9]+(\\.[0-9]+){0,3}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "custodian": {
                  "oneOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9]+(\\.[0-9]+){0,3}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "emmet-core": {
                  "oneOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9]+(\\.[0-9]+){0,3}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "jobflow": {
                  "oneOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9]+(\\.[0-9]+){0,3}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "spglib": {
                  "oneOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9]+(\\.[0-9]+){0,3}$"
