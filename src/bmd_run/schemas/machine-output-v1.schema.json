                "plan_changed",
                "attempt_fingerprint_mismatch",
                "runtime_package_changed",
                "attempt_in_progress",
                "attempt_busy",
                "submission_not_started",
                "submission_uncertain",
                "remote_state_invalid",
                "request_too_large",
                "unsupported_media_type",
                "invalid_request",
                "structure_invalid",
                "calculation_invalid",
                "invalid_attempt_id",
                "resource_limit_exceeded",
                "active_job_cap_exceeded",
                "submission_cap_exceeded",
                "attempt_cap_exceeded",
                "plan_failed",
                "attempt_failed",
                "lookup_failed",
                "server_misconfigured",
                "prepare_failed",
                "submit_failed",
                "api_not_configured",
                "execution_not_configured",
                "remote_busy",
                "remote_unavailable",
