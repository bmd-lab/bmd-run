            "automatic_dft_u": {
              "oneOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "method_considerations": {
              "oneOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "custodian": {
              "oneOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "runtime_parity": {
              "oneOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
