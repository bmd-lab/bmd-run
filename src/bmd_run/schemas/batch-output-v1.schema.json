{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "bmd_run.batch_output/1",
  "title": "BMD Run batch output document, schema version 1",
  "description": "Emitted on stdout by 'bmd-run batch MANIFEST --json' (command 'batch') and 'bmd-run batch status MANIFEST --json' (command 'batch_status'), on success and on error. One entry per manifest calculation, in manifest order. 'category' is the client's classification (pending, submitted, completed, failed, uncertain); 'action' is what this run did ('batch' only). Plan, attempt and scheduler values are the client's projections of BMD Compute machine API v1 responses (bmd-compute e3fbb3b), with the same rules as bmd_run.machine_output v1: no Compute prose and never the API token. resources.requested_memory_gb is the memory requested for the job, not measured peak memory.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "campaign",
    "cells",
    "client",
    "command",
    "compute_api",
    "error",
    "manifest",
    "memory_note",
    "ok",
    "options",
    "schema",
    "schema_version",
    "summary",
    "warnings"
  ],
  "properties": {
    "schema": {
      "const": "bmd_run.batch_output"
    },
    "schema_version": {
      "const": 1
    },
    "client": {
      "type": "object",
      "required": [
        "name",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "const": "bmd-run"
        },
        "version": {
          "type": "string"
        }
      }
    },
    "command": {
      "enum": [
        "batch",
        "batch_status"
      ]
    },
    "ok": {
      "type": "boolean"
    },
    "compute_api": {
      "type": "object",
      "required": [
        "api_version",
        "origin",
        "reference_commit"
      ],
      "additionalProperties": false,
      "properties": {
        "origin": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "api_version": {
          "const": "v1"
        },
        "reference_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        }
      }
    },
    "campaign": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "manifest": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "calculation_count",
            "file_name",
            "sha256"
          ],
          "additionalProperties": false,
          "properties": {
            "file_name": {
              "type": "string"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "calculation_count": {
              "type": "integer"
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "options": {
      "type": "object",
      "required": [
        "max_new",
        "refresh"
      ],
      "additionalProperties": false,
      "properties": {
        "max_new": {
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "refresh": {
          "oneOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "summary": {
      "type": "object",
      "required": [
        "completed",
        "failed",
        "new_attempts",
        "pending",
        "submitted",
        "uncertain"
      ],
      "additionalProperties": false,
      "properties": {
        "pending": {
          "type": "integer"
        },
        "submitted": {
          "type": "integer"
        },
        "completed": {
          "type": "integer"
        },
        "failed": {
          "type": "integer"
        },
        "uncertain": {
          "type": "integer"
        },
        "new_attempts": {
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "cells": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/cell"
      }
    },
    "memory_note": {
      "type": "string"
    },
    "error": {
      "oneOf": [
        {
          "$ref": "#/$defs/error"
        },
        {
          "type": "null"
        }
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "cell": {
      "type": "object",
      "required": [
        "action",
        "attempt_id",
        "attempt_state",
        "category",
        "cell",
        "job_id",
        "last_error",
        "local_state",
        "observed_at",
        "plan_digest",
        "recovery",
        "resources",
        "scheduler",
        "structure",
        "structure_source",
        "workflow"
      ],
      "additionalProperties": false,
      "properties": {
        "cell": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "category": {
          "enum": [
            "pending",
            "submitted",
            "completed",
            "failed",
            "uncertain"
          ]
        },
        "action": {
          "oneOf": [
            {
              "enum": [
                "submitted",
                "already_submitted",
                "uncertain_skipped",
                "not_started",
                "failed",
                "stopped",
                "not_reached"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "attempt_id": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "local_state": {
          "oneOf": [
            {
              "enum": [
                "planned",
                "prepare_unconfirmed",
                "registered",
                "prepared",
                "submit_unconfirmed",
                "submitted",
                "submission_uncertain"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "plan_digest": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "structure_source": {
          "$ref": "#/$defs/structure_source"
        },
        "structure": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "crystal_system",
                "formula",
                "natoms",
                "reduced_formula",
                "space_group_number"
              ],
              "additionalProperties": false,
              "properties": {
                "formula": {
                  "type": "string"
                },
                "reduced_formula": {
                  "type": "string"
                },
                "natoms": {
                  "type": "integer"
                },
                "space_group_number": {
                  "oneOf": [
                    {
                      "type": "integer"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "crystal_system": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "workflow": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "desired_output",
                "mode",
                "stage_count",
                "stages"
              ],
              "additionalProperties": false,
              "properties": {
                "mode": {
                  "enum": [
                    "desired_output",
                    "custom"
                  ]
                },
                "desired_output": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "stage_count": {
                  "type": "integer"
                },
                "stages": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": [
                      "modifiers",
                      "stage_type",
                      "theory"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "stage_type": {
                        "oneOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "theory": {
                        "oneOf": [
                          {
                            "type": "string"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "modifiers": {
                        "type": "array",
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "resources": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "account",
                "cpus",
                "nodes",
                "partition",
                "requested_memory_gb",
                "walltime_limit"
              ],
              "additionalProperties": false,
              "properties": {
                "nodes": {
                  "type": "integer"
                },
                "cpus": {
                  "type": "integer"
                },
                "requested_memory_gb": {
                  "type": "integer"
                },
                "walltime_limit": {
                  "type": "string",
                  "pattern": "^[0-9]{2,4}:[0-5][0-9]:[0-5][0-9]$"
                },
                "partition": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "account": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "qos": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "sources": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "cpus": {
                      "oneOf": [
                        {
                          "enum": [
                            "automatic",
                            "manual"
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "memory_gb": {
                      "oneOf": [
                        {
                          "enum": [
                            "automatic",
                            "manual"
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "walltime": {
                      "oneOf": [
                        {
                          "enum": [
                            "automatic",
                            "manual"
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "queue": {
                      "oneOf": [
                        {
                          "enum": [
                            "automatic",
                            "manual"
                          ]
                        },
                        {
                          "type": "null"
                        }
                      ]
                    }
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "job_id": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{1,20}(_[0-9]{1,10})?$"
            },
            {
              "type": "null"
            }
          ]
        },
        "attempt_state": {
          "oneOf": [
            {
              "enum": [
                "registered",
                "prepared",
                "submitted",
                "submission_uncertain"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "scheduler": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "elapsed",
                "ended_at",
                "exit_code",
                "started_at",
                "state",
                "summary",
                "terminal"
              ],
              "additionalProperties": false,
              "properties": {
                "state": {
                  "type": "string"
                },
                "summary": {
                  "enum": [
                    "PENDING",
                    "RUNNING",
                    "SUCCESS",
                    "FAILURE",
                    "UNKNOWN"
                  ]
                },
                "elapsed": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "exit_code": {
                  "oneOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9]{1,3}:[0-9]{1,3}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "started_at": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "ended_at": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "terminal": {
                  "type": "boolean"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_at": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "last_error": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "at",
                "compute_code",
                "kind",
                "stage"
              ],
              "additionalProperties": false,
              "properties": {
                "stage": {
                  "enum": [
                    "plan",
                    "prepare",
                    "submit"
                  ]
                },
                "kind": {
                  "type": "string"
                },
                "compute_code": {
                  "oneOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "at": {
                  "type": "string"
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "recovery": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^bmd-run api (status|submit) [0-9a-f-]{36}$"
          }
        }
      }
    },
    "error": {
      "type": "object",
      "required": [
        "attempt",
        "attempt_id",
        "compute_code",
        "compute_stage",
        "diagnostic_code",
        "fields",
        "http_status",
        "kind",
        "message",
        "resolved_plan_digest",
        "suggestion"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "usage_error",
            "compute_unreachable",
            "compute_rejected",
            "unexpected_response",
            "authentication_failed",
            "insufficient_scope",
            "invalid_request",
            "plan_digest_mismatch",
            "attempt_conflict",
            "submission_uncertain",
            "quota_exceeded",
            "service_unavailable",
            "network_timeout",
            "attempt_not_found",
            "remote_operation_failed",
            "credentials_unavailable",
            "local_state_error"
          ]
        },
        "message": {
          "type": "string"
        },
        "suggestion": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "http_status": {
          "oneOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "compute_stage": {
          "type": "null"
        },
        "compute_code": {
          "oneOf": [
            {
              "enum": [
                "query_not_allowed",
                "invalid_json",
                "unauthenticated",
                "loopback_required",
                "insufficient_scope",
                "attempt_forbidden",
                "attempt_not_found",
                "plan_digest_mismatch",
                "attempt_request_mismatch",
                "plan_changed",
                "attempt_fingerprint_mismatch",
                "runtime_package_changed",
                "attempt_in_progress",
                "attempt_busy",
                "submission_not_started",
                "submission_uncertain",
                "remote_state_invalid",
                "request_too_large",
                "unsupported_media_type",
                "invalid_request",
                "structure_invalid",
                "calculation_invalid",
                "invalid_attempt_id",
                "resource_limit_exceeded",
                "active_job_cap_exceeded",
                "submission_cap_exceeded",
                "attempt_cap_exceeded",
                "plan_failed",
                "attempt_failed",
                "lookup_failed",
                "server_misconfigured",
                "prepare_failed",
                "submit_failed",
                "api_not_configured",
                "execution_not_configured",
                "remote_busy",
                "remote_unavailable",
                "remote_state_unconfirmed",
                "submission_outcome_unconfirmed"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "attempt_id": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "fields": {
          "oneOf": [
            {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "field",
                  "problem"
                ],
                "additionalProperties": false,
                "properties": {
                  "field": {
                    "oneOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "problem": {
                    "oneOf": [
                      {
                        "enum": [
                          "unknown_field",
                          "required",
                          "must_be_object",
                          "must_be_poscar_or_cif",
                          "must_be_nonempty_string",
                          "too_large",
                          "invalid_characters",
                          "exactly_one_of_desired_output_or_custom",
                          "must_be_identifier",
                          "must_be_positive_integer",
                          "must_be_hh_mm_ss",
                          "must_be_nonempty_list",
                          "too_many_stages",
                          "must_be_identifier_list",
                          "must_be_sha256_digest",
                          "must_be_boolean",
                          "must_be_label"
                        ]
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                }
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "diagnostic_code": {
          "oneOf": [
            {
              "enum": [
                "unknown_desired_output",
                "hse06_soc_not_supported_for_new_calculations",
                "automatic_dispersion_dimensionality_analysis_failed",
                "unsupported_combination"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "resolved_plan_digest": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "attempt": {
          "oneOf": [
            {
              "$ref": "#/$defs/attempt"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "attempt": {
      "type": "object",
      "required": [
        "attempt_id",
        "created_at",
        "label_keys",
        "plan_digest",
        "resources",
        "scheduler",
        "state",
        "submission"
      ],
      "additionalProperties": false,
      "properties": {
        "attempt_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "plan_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "state": {
          "enum": [
            "registered",
            "prepared",
            "submitted",
            "submission_uncertain"
          ]
        },
        "created_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "resources": {
          "$ref": "#/$defs/resources"
        },
        "submission": {
          "type": "object",
          "required": [
            "job_id",
            "requested",
            "submitted_at_local"
          ],
          "additionalProperties": false,
          "properties": {
            "requested": {
              "type": "boolean"
            },
            "job_id": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9]{1,20}(_[0-9]{1,10})?$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "submitted_at_local": {
              "oneOf": [
                {
                  "type": "string",
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2} [0-9]{2}:[0-9]{2}:[0-9]{2}$"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        "scheduler": {
          "oneOf": [
            {
              "type": "object",
              "required": [
                "available",
                "checked_at",
                "elapsed",
                "ended_at",
                "exit_code",
                "started_at",
                "state",
                "summary",
                "terminal"
              ],
              "additionalProperties": false,
              "properties": {
                "available": {
                  "type": "boolean"
                },
                "summary": {
                  "enum": [
                    "PENDING",
                    "RUNNING",
                    "SUCCESS",
                    "FAILURE",
                    "UNKNOWN"
                  ]
                },
                "state": {
                  "enum": [
                    "PENDING",
                    "CONFIGURING",
                    "RUNNING",
                    "COMPLETING",
                    "COMPLETED",
                    "FAILED",
                    "TIMEOUT",
                    "CANCELLED",
                    "OUT_OF_MEMORY",
                    "NODE_FAIL",
                    "PREEMPTED",
                    "BOOT_FAIL",
                    "DEADLINE",
                    "SUSPENDED",
                    "REQUEUED",
                    "REQUEUE_HOLD",
                    "REQUEUE_FED",
                    "RESIZING",
                    "SIGNALING",
                    "STAGE_OUT",
                    "SPECIAL_EXIT",
                    "STOPPED",
                    "REVOKED",
                    "RESV_DEL_HOLD",
                    "UNKNOWN"
                  ]
                },
                "exit_code": {
                  "oneOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9]{1,3}:[0-9]{1,3}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "elapsed": {
                  "oneOf": [
                    {
                      "type": "string",
                      "pattern": "^([0-9]{1,4}-)?[0-9]{2}:[0-9]{2}:[0-9]{2}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "started_at": {
                  "oneOf": [
                    {
                      "type": "string",
